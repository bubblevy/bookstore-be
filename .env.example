APP_ENV=development
LOG_PATH=logs/app.log
PORT=8000
APP_NAME=BookStore
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=bookstore
EMAIL_LOGO_URL=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30
JWT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
BASE_URL=http://localhost:8000
EMAIL_FROM_NAME=Bookstore
EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_USE_TLS=false
FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/api/v1/auth/google/callback

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_ORIGIN_AREA_ID=
BITESHIP_ORIGIN_POSTAL_CODE=
BITESHIP_WEBHOOK_SECRET=
BITESHIP_AVAILABLE_COURIERS=jne,sicepat,jnt,anteraja,idexpress
STORE_SHIPPER_NAME="Bookstore"
STORE_SHIPPER_PHONE="081234567890"
STORE_SHIPPER_EMAIL="admin@bookstore.com"
STORE_ORIGIN_NAME="Bookstore"
STORE_ORIGIN_PHONE="081234567890"
STORE_ORIGIN_ADDRESS="Jl. Adadeh, Jakarta Selatan"

# Object Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_BASE_DIR=./public
STORAGE_LOCAL_URL_PREFIX=/api/v1/static

# AWS S3 / MinIO / Cloudflare R2 (Optional if STORAGE_DRIVER=s3)
# AWS_S3_BUCKET=
# AWS_S3_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT=
# AWS_S3_CDN_URL=
# AWS_S3_USE_PATH_STYLE=false

# Redis
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Or direct AMQP URL:
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/